# Copy to .env.local for local development. All variables are optional.
# NEXT_PUBLIC_* values are baked into the client bundle at build time, so they
# are public by design. Never put a secret in a NEXT_PUBLIC_ variable
# (see docs/tokens.md).

# Branding: "mahoje" (kort.mahoje.dk, default) or "solaris" (kort.solaris.dk).
NEXT_PUBLIC_BRAND=mahoje

# Free public token from https://dataforsyningen.dk/ (map tiles and WMS).
# Empty = use the fallback token in src/lib/map/styles.ts. Please use your own
# token if you deploy your own copy.
NEXT_PUBLIC_DATAFORSYNINGEN_TOKEN=

# Token for Adressevælger (address search, Klimadatastyrelsen).
# Empty = use the fallback in src/lib/api/address.ts.
NEXT_PUBLIC_ADRESSEVAELGER_TOKEN=

# SERVER-SIDE secret, not NEXT_PUBLIC_: Datafordeler API key for the Danish
# raster layers (DTK25, orthophoto, historic maps, place names, DHM contours
# and hillshade). The tile route /api/tiles adds it on the server; it never
# reaches the browser. Read at runtime, so set it as a runtime environment
# variable (no rebuild needed). Empty = the route serves the same tiles from
# Dataforsyningen's older _DAF services with the public token above, which is
# fine for forks and local development but stops working when those services
# close (26 Nov 2026). See docs/tokens.md.
DATAFORDELER_API_KEY=

# PMTiles URL for the 5 m / 10 m contour overlay.
# Empty = https://tiles.mahoje.dk/kurver-5m.pmtiles
NEXT_PUBLIC_CONTOURS_URL=
